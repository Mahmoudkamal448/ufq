# Copy this file to .env and change the values.

# Password for the admin page (/admin/). At least 8 characters. REQUIRED.
ADMIN_PASSWORD=change-me-please

# Port on this machine where the website is published.
WEB_PORT=8080

# Largest file allowed to upload, in MB (videos can be big).
MAX_UPLOAD_MB=500

# How long an admin stays logged in, in hours.
SESSION_HOURS=12
